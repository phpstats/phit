{
    "name": "phpstats/phit",
    "description": "Native Rust statistical modeling for PHP: regression, likelihood and mixed models",
    "type": "php-ext",
    "license": "MIT",
    "require": {
        "php": ">=8.3 <8.6"
    },
    "php-ext": {
        "extension-name": "phit",
        "build-path": "pie",
        "support-nts": true,
        "support-zts": false,
        "os-families": ["linux", "darwin"]
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13"
    }
}
