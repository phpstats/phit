{
    "name": "phpstats/phit",
    "description": "Native Rust statistical modeling for PHP: regression, likelihood and mixed models",
    "type": "php-ext",
    "license": "MIT",
    "require": {
        "php": ">=8.3 <8.6"
    },
    "php-ext": {
        "extension-name": "phit",
        "build-path": "pie",
        "support-nts": true,
        "support-zts": false,
        "os-families": [
            "linux",
            "darwin"
        ],
        "download-url-method": [
            "pre-packaged-binary",
            "composer-default"
        ]
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13"
    },
    "scripts": {
        "lint": [
            "phpcs",
            "@test:sniffs"
        ],
        "test:sniffs": "php tools/phpcs/selftest/run.php"
    }
}
